<Project Sdk="Microsoft.NET.Sdk">

  <!-- Builds the portable parts of the animation writer on any platform, so the output can
       be produced and checked without a Windows machine. Not part of the shipped app. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>GifProbe</AssemblyName>
    <RootNamespace>GifProbe</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="../../src/Stepwright/Export/Gif/*.cs" />
  </ItemGroup>

</Project>
